# Pikafish engine binaries + NNUE (~120 MB, downloaded separately, see README)
engine/

# Engine analysis logs — verbose, regenerated on every rerun
output/*.log
# Sample markdown output of analyze.py — kept locally, not for repo
output/*.md
# Trap review tables — regenerable from list_trap_plies.py
output/*.csv
# SQLite eval DB (Phase 1, consumed by chess-book-editor). Regenerable from
# positions*.js / chessdb_cache.json via site_builder/migrate_to_sqlite.py.
# See SQLITE_EVAL_DB.md.
output/positions.db
output/positions.db-wal
output/positions.db-shm

# Master game manifest — 115 MB once the 中貴棋譜 corpus expanded past
# GitHub's 100 MB hard file limit. Regenerable from XQF source by
# site_builder/build_data.py --scan-only.
output/site/data/games.json

# Sidecar cache for build_data.py --single-file smoke tests of the new DFS
# evaluator (see D12_TT_SWEEP.md). Regenerable; not for distribution.
output/site/positions_single_test.js

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs / one-off run output
*.log

# Claude Code session state
.claude/

# Test sample corpus — only the one file smoke_xqf.py needs is checked in.
# Master keeps a wider sample library locally (CBL teaching books etc.) but
# we don't want those in the repo: bloat + book-copyright concerns.
samples/*
!samples/xqf/
samples/xqf/*
!samples/xqf/中砲對單提馬.XQF
